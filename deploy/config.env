CFG_VERSION=1

# Environment for the valheim container and the mods initContainer.
# Rendered into the `config` ConfigMap by the configMapGenerator in
# kustomization.yaml; every edit here changes the ConfigMap's hash suffix and
# therefore the pod template, so Flux rolls the pod automatically.
# One KEY=VALUE per line, no quoting. MODS lives in mods.txt.

SERVER_NAME=Stray Dogs
WORLD_NAME=DeepNorth
SERVER_PUBLIC=false
BACKUPS_CRON=0 0/2 * * *

# Vanilla world modifier: resource drops one notch above default
# (MuchLess / Less / Default / More / MuchMore / Most). Applied to the existing world
# on startup and saved into the world file - so removing this line does NOT
# revert it; set "Resources Default" to go back.
SERVER_ARGS=-modifier Resources Most

# Mod loader. Mutually exclusive with VALHEIM_PLUS.
BEPINEX=true

POST_BEPINEX_CONFIG_HOOK=rsync -a --delete --itemize-changes /config/bepinex/plugins/ "$plugins_path" ; rsync -a --delete --itemize-changes /config/bepinex/patchers/ "$(dirname "$plugins_path")/patchers"
